# ─── Required ────────────────────────────────────────────────────────────────

# SQLite database path (relative to project root or absolute)
DATABASE_URL="file:./tunnel-manager.db"

# 32-character (256-bit) secret used to encrypt Cloudflare credentials at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="change-me-to-a-32-byte-hex-secret-value"

# 32+ character secret for iron-session cookie signing.
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-session-secret"

# ─── Optional ────────────────────────────────────────────────────────────────

# Port for the Next.js server (default: 3000)
PORT=3000

# Set to "production" in production environments
NODE_ENV="development"

# Background sync interval in milliseconds (default: 60000 = 1 minute)
SYNC_INTERVAL_MS=60000

# Maximum Cloudflare API retry attempts (default: 3)
CF_MAX_RETRIES=3

# Base delay for exponential backoff in ms (default: 500)
CF_RETRY_BASE_DELAY_MS=500

# ─── SMTP (for password reset emails) ────────────────────────────────────────
# Required only if you want the forgot-password flow to send emails.
# Without these, users must use the CLI reset script instead.

# Public URL of the app (used to build reset links in emails)
# APP_URL="https://your-domain.example.com"

# SMTP server settings
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_SECURE="false"         # "true" for port 465 (TLS/SSL), "false" for STARTTLS
# SMTP_USER="postmaster@mg.example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="TunnelFlow <noreply@example.com>"

# ─── AI Agent & MCP Configuration ──────────────────────────────────────────
# AI Provider: "auto" (default: uses built-in autonomous expert engine, or auto-detects API key)
# Optional: "openai" | "anthropic" | "groq" | "cloudflare"
AI_PROVIDER="auto"

# Optional external LLM API keys:
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GROQ_API_KEY="gsk_..."
# CLOUDFLARE_ACCOUNT_ID="your-cf-account-id"
# CLOUDFLARE_API_TOKEN="your-cf-api-token"
